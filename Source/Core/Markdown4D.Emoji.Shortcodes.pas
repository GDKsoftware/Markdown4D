class function TEmojiShortcodes.TryDecode(const Name: string; out Decoded: string): Boolean;
begin
  Decoded := '';

  var LowIndex := 0;
  var HighIndex := EmojiCount - 1;

  while LowIndex <= HighIndex do
  begin
    const MidIndex = (LowIndex + HighIndex) div 2;
    const Comparison = CompareStr(Name, Emojis[MidIndex].Name);

    if Comparison = 0 then
    begin
      Decoded := Emojis[MidIndex].Value;
      Result := True;
      Exit;
    end;

    if Comparison < 0 then
      HighIndex := MidIndex - 1
    else
      LowIndex := MidIndex + 1;
  end;

  Result := False;
end;

class function TEmojiShortcodes.Count: Integer;
begin
  Result := EmojiCount;
end;

class function TEmojiShortcodes.NameAt(const Index: Integer): string;
begin
  const IsInRange = (Index >= 0) and (Index < EmojiCount);
  if not IsInRange then
    raise EArgumentOutOfRangeException.CreateFmt('Emoji index %d is out of range', [Index]);

  Result := Emojis[Index].Name;
end;

end.
